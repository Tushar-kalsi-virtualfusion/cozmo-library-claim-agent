# Keep this on the Mac, never in the iPhone app or git.
CLAIM_PROVIDER=openai
OPENAI_API_KEY=
CLAIM_VISION_MODEL=gpt-6-astra
CLAIM_LIVE_MODEL=gpt-realtime-2.1
# Optional legacy providers. OpenAI mode never calls Claude or ElevenLabs.
# Multi-workspace keys require the actual wrkspc_ ID,
# not the workspace's display name. Workspace-scoped keys can omit this header.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# OpenAI voice uses CLAIM_LIVE_MODEL directly, without a separate text request.
# These limits apply to the legacy Claude text assistant.
CLAIM_ASSISTANT_MODEL=
CLAIM_ASSISTANT_MAX_CALLS=60
CLAIM_ASSISTANT_TIMEOUT_S=40
CLAIM_ASSISTANT_MAX_TOKENS=2048
# To select Gemini: CLAIM_PROVIDER=gemini, GOOGLE_API_KEY, and compatible Gemini model names.
GOOGLE_API_KEY=
# Provider search discovers source URLs; retrieved retailer offers establish prices.
CLAIM_DATA_DIR=data
CLAIM_HOST=127.0.0.1
# For an iPhone, use CLAIM_HOST=0.0.0.0 and set CLAIM_PHONE_HOST to the
# Mac local network name from `scutil --get LocalHostName`, followed by .local.
CLAIM_PHONE_HOST=
CLAIM_PORT=4180
# Leave empty to generate a temporary pairing token on server start.
CLAIM_PAIR_TOKEN=
CLAIM_WORKERS=2
CLAIM_QUEUE_SIZE=12
CLAIM_FINISH_TIMEOUT=240
CLAIM_APPRAISAL_THRESHOLD_INR=10000
# Default: resolve supported phone OCR/book clues locally and via free Open Library.
# Cloud vision is reserved for clear novel unresolved evidence, bounded per sweep.
CLAIM_LOCAL_FIRST=true
CLAIM_CLOUD_MAX_CALLS=20
CLAIM_CLOUD_COOLDOWN_S=6
# Paid retailer search and continuous cloud voice require explicit server opt-in.
# Continuous voice uses one OpenAI Realtime speech-to-speech connection.
CLAIM_PAID_PRICING=true
CLAIM_CLOUD_VOICE=true

# Natural streaming voice. Provider keys stay on the server.
ELEVENLABS_API_KEY=
CLAIM_SPEECH_PROVIDER=openai
CLAIM_SPEECH_INPUT_MODEL=gpt-realtime-2.1
CLAIM_SPEECH_OUTPUT_MODEL=gpt-realtime-2.1
CLAIM_SPEECH_VOICE=marin
CLAIM_SPEECH_MAX_CALLS=240
CLAIM_SPEECH_TIMEOUT_S=40
